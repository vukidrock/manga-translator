{
  "hosting": {
    "site": "mt-vuhuynh",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".firebase/**",
      "**/.DS_Store",
      "**/node_modules/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "AGENTS.md",
      "README*",
      "*.md",
      "test-page.png"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
        ]
      }
    ]
  }
}
